{
  "name": "tarea-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:pro": "APP_VARIANT=handyman expo start",
    "start:customer": "APP_VARIANT=customer expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:pro": "APP_VARIANT=handyman expo run:android",
    "android:customer": "APP_VARIANT=customer expo run:android",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:pro": "eas build --platform android --profile preview-handyman",
    "update:pro": "APP_VARIANT=handyman eas update --branch production-handyman",
    "update:customer": "APP_VARIANT=customer eas update --branch production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.0",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.29.0",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "expo-video": "~3.0.16",
    "lucide-react-native": "^1.25.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-maps": "^1.14.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.10",
    "typescript": "^5.3.0"
  }
}
