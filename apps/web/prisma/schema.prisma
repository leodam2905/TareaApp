// Tarea - Handyman App Database Schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  HANDYMAN
  ADMIN
}

enum AccountType {
  INDIVIDUAL
  COMPANY
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum BackgroundCheckStatus {
  PENDING
  DEFERRED
  PAID
  IN_PROGRESS
  PASSED
  FAILED
}

enum ServiceCategory {
  PLUMBING
  ELECTRICAL
  CARPENTRY
  PAINTING
  CLEANING
  HVAC
  ROOFING
  LANDSCAPING
  MOVING
  APPLIANCE_REPAIR
  LAUNDRY
  GENERAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone           String?
  expoPushToken   String?
  fcmToken        String?
  passwordHash String
  passwordChangedAt DateTime?
  role         Role     @default(CUSTOMER)
  avatarUrl    String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  latitude     Float?
  longitude    Float?
  accountType  AccountType @default(INDIVIDUAL)
  companyName  String?
  companyLogoUrl String?
  ein          String?
  website      String?
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  stripeAccountId     String?
  stripeAccountStatus String?
  // Customer-side Stripe identity: lets us charge a saved card off-session
  // (authorization hold at acceptance, add-on charges during the job).
  stripeCustomerId       String?
  defaultPaymentMethodId String?
  notifBookingUpdates Boolean @default(true)
  notifReminders      Boolean @default(true)
  notifMessages       Boolean @default(true)
  notifSms            Boolean @default(true)
  referralCode        String? @unique
  referredBy          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  handymanProfile    HandymanProfile?
  bookingsAsCustomer Booking[]        @relation("CustomerBookings")
  bookingsAsHandyman Booking[]        @relation("HandymanBookings")
  reviewsGiven       Review[]         @relation("ReviewsGiven")
  reviewsReceived    Review[]         @relation("ReviewsReceived")
  notifications      Notification[]
  jobRequests        JobRequest[]     @relation("CustomerJobRequests")
  jobApplications    JobApplication[] @relation("HandymanApplications")
  messagesSent       Message[]        @relation("MessagesSent")
  otpCodes           OtpCode[]
  favorites          Favorite[]       @relation("CustomerFavorites")
  deviceTokens       DeviceToken[]

  @@map("users")
}

// One row per push-registered device. Replaces the single User.fcmToken /
// expoPushToken columns so a user logged in on multiple devices receives every
// notification on all of them. Token is unique so re-registering the same
// device (or moving it to another account) upserts rather than duplicates.
model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String?  // "ios" | "android" | "expo"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

// One record per push send attempt, per device.
//
// sendFcm() previously discarded FCM's response and logged only failures, so the
// only trace of a send was the notifications row written next to it. That made
// "never sent" and "sent but the device swallowed it" indistinguishable without
// re-running live tests against a real phone.
//
// `accepted_by_fcm` is NOT delivery. FCM returning a message name means it
// accepted the message; a device with notifications disabled returns success
// identically. Device receipt, if ever added, is a separate signal acknowledged
// by the app — never inferred from this table.
model FcmOutbox {
  id             String    @id @default(cuid())
  notificationId String?   @map("notification_id")
  userId         String    @map("user_id")
  purpose        String

  // The raw token is not duplicated here — device_tokens holds it, and a token
  // is a credential-shaped value. The hash correlates a send to a device
  // without widening exposure.
  deviceTokenId  String?   @map("device_token_id")
  tokenHash      String    @map("token_hash")
  platform       String?

  // Idempotency: one row per (purpose, notification, device). A retry cannot
  // produce a second push. Enforced by the unique index, not by convention.
  dedupeKey      String    @unique(map: "fcm_outbox_dedupe_uidx") @map("dedupe_key")

  status         String    @default("queued") // queued | accepted_by_fcm | invalid_token | error
  attemptCount   Int       @default(0) @map("attempt_count")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  nextAttemptAt  DateTime? @map("next_attempt_at")

  fcmMessageName String?   @map("fcm_message_name") // provider ack; not delivery
  errorCode      String?   @map("error_code")       // sanitized provider code only

  createdAt      DateTime  @default(now())  @map("created_at")
  updatedAt      DateTime  @updatedAt       @map("updated_at")

  @@index([status, nextAttemptAt], map: "fcm_outbox_retry_idx")
  @@index([notificationId], map: "fcm_outbox_notification_idx")
  @@index([userId, createdAt], map: "fcm_outbox_user_created_idx")
  @@map("fcm_outbox")
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

model HandymanProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  yearsExperience Int      @default(0)
  hourlyRate      Float
  isAvailable     Boolean  @default(true)
  rating          Float    @default(0)
  totalJobs       Int      @default(0)
  totalEarnings   Float    @default(0)
  responseTime    Int      @default(60)
  serviceRadius   Int      @default(50) // MILES the pro will travel; drives eligibility

  // Server-derived service centre, geocoded from the pro's address. Paired with
  // serviceRadius above to decide eligibility. Unsupported() because Prisma has
  // no geography type — queried via $queryRaw against the GiST index.
  servicePoint      Unsupported("geography(Point, 4326)")? @map("service_point")
  geocodeConfidence Float?    @map("geocode_confidence")
  geocodeSource     String?   @map("geocode_source")
  geocodedAt        DateTime? @map("geocoded_at")
  isPremium             Boolean  @default(false)
  stripeSubId           String?
  stripeSubStatus       String?
  verificationDocUrl    String?
  verificationStatus    String   @default("none") // none | pending | approved | rejected
  backgroundCheckStatus BackgroundCheckStatus @default(PENDING)
  backgroundCheckPaidAt DateTime?
  backgroundCheckRef    String?
  icaSignedAt           DateTime?
  icaSignedIp           String?
  // AGREEMENT_VERSION of the text actually shown when they accepted (mig 011).
  // NULL = signed before versions were recorded, not "signed the current one".
  icaSignedVersion      String?
  idFrontUrl            String?
  idBackUrl             String?

  // Renewable credentials. Each document carries its OWN decision and expiry:
  // a current licence and a lapsed insurance certificate are two different
  // facts, and an admin has to be able to accept one while bouncing the other.
  // `verificationStatus` above stays what it has always been — the *identity*
  // decision — and is not reused here.
  //
  // Status is `none | pending | approved | rejected`. Expiry is NOT written
  // back into it; a document past `expiresAt` reads as expired at query time
  // (see lib/credentials.ts) so a lapsed licence stops counting the moment it
  // lapses, with no cron to run and nothing to keep in sync.
  licenseNumber         String?
  // The name AS PRINTED ON THE LICENCE. Licence numbers are public record, so
  // a number alone proves nothing — anyone can type a real contractor's. This
  // is what a reviewer compares against the pro's own name, and it is the only
  // thing standing between a badge and impersonation.
  licenseeName          String?
  licenseDocUrl         String?
  licenseIssuer         String?   // issuing authority, e.g. "CSLB" / "TX TDLR"
  licenseStatus         String    @default("none")
  licenseExpiresAt      DateTime?
  licenseReviewedAt     DateTime?
  licenseReviewNote     String?   // why it was rejected — shown to the pro
  insuranceDocUrl       String?
  insuranceProvider     String?
  insurancePolicyNumber String?
  // Name as printed on the certificate. A COI is a one-page PDF that anybody
  // can forward, so the named insured is the only thing tying it to THIS pro.
  insuranceNamedInsured String?
  // Limits in whole dollars, as stated on the ACORD form. Checked against the
  // ICA minimums ($1M per occurrence / $2M aggregate) instead of eyeballed —
  // a certificate for $100k looks exactly like one for $1M at a glance.
  insurancePerOccurrence Int?
  insuranceAggregate     Int?
  insuranceStatus       String    @default("none")
  insuranceExpiresAt    DateTime?
  insuranceReviewedAt   DateTime?
  insuranceReviewNote   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     Service[]
  availability    HandymanAvailability[]
  jobApplications JobApplication[]
  portfolioPhotos PortfolioPhoto[]
  favorites Favorite[]

  @@map("handyman_profiles")
}

model HandymanAvailability {
  id        String @id @default(cuid())
  profileId String
  dayOfWeek Int    // 0=Sun … 6=Sat
  startHour Int    // 0-23
  endHour   Int    // 0-23

  profile HandymanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dayOfWeek])
  @@map("handyman_availability")
}

model Service {
  id          String          @id @default(cuid())
  handymanId  String?
  title       String
  description String
  category    ServiceCategory
  hourlyRate  Float?          // what this pro charges per hour for this category
  minimumMinutes Int?         // shortest billable job for this category (mig 013)
  minPrice    Float?          // legacy range, no longer written - dropped in a later migration
  maxPrice    Float?
  duration    Int             // in minutes
  imageUrl    String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  handyman HandymanProfile? @relation(fields: [handymanId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("services")
}

model Booking {
  id           String        @id @default(cuid())
  customerId   String
  handymanId   String
  serviceId    String
  // The job request this booking came from, when it came from one. Without it
  // a completed booking could not close the request that produced it, so a
  // customer saw a job they had already had done still sitting as ASSIGNED.
  // Null for directed bookings, which never had a request.
  jobRequestId String?
  promoCodeId  String?
  status       BookingStatus @default(PENDING)
  scheduledAt  DateTime
  address      String
  city         String
  notes        String?
  totalPrice   Float
  isPaid                Boolean       @default(false)
  stripeSessionId       String?
  stripePaymentIntentId String?
  // Uber-style hold: authorize at acceptance, capture at completion.
  authorizedAmount      Float?
  authorizedAt          DateTime?
  authExpiresAt         DateTime?   // holds lapse after ~7 days
  capturedAmount        Float?
  capturedAt            DateTime?
  completedAt      DateTime?
  cancelReason     String?
  responseDeadline DateTime?
  isOnMyWay        Boolean       @default(false)
  handymanLat      Float?
  handymanLng      Float?
  disputeReason    String?
  disputedBy       String?
  disputedAt       DateTime?
  resolutionNote   String?
  resolvedAt       DateTime?
  // What this job was priced FROM, frozen at booking time (migration 010).
  // initialLaborAmount = (proRateSnapshot / 60) * estimatedBillableMinutes.
  // Snapshots, so a later rate change cannot rewrite an agreed price.
  proRateSnapshot          Float?
  estimatedBillableMinutes Int?     // Tarea AI's single estimate of billable time
  initialLaborAmount       Float?
  minimumChargeSnapshot    Float?
  minimumMinutesSnapshot   Int?     // the pro's minimum billable time, frozen
  pricingType              String?  // hourly | service | quote_required

  materialsEstimate Float         @default(0)
  // What the materials actually cost, entered by the pro at work-done with the
  // receipt. Materials are charged at cost CAPPED AT THE ESTIMATE: spend less
  // and the difference is refunded to the customer; spend more and the pro
  // absorbs it, because the customer agreed to a number before the job.
  // Null means no figure was given, and the estimate stands.
  materialsActual   Float?
  materialsRefunded Float?        // what was actually returned, once refunded
  // What the model read off the receipt photo. EVIDENCE, not a decision — the
  // refund is always computed from materialsActual. Migration 015.
  materialsReceiptTotal Float?
  // none | verified | review. `review` means the reading and the pro's figure
  // disagree, or the receipt was unreadable; an admin settles it rather than a
  // model moving money toward the customer out of the pro's pocket.
  materialsVerified String   @default("none")
  jobStartedAt     DateTime?
  // The on-site timer is informational — the price is fixed before the pro is
  // chosen, so pausing never changes what anyone is paid. It exists so both
  // parties see the same number: a pro who stops for lunch, or waits on a part,
  // should not have a clock running in front of the customer.
  //
  // Elapsed is derived, never stored:
  //   (now - jobStartedAt) - pausedSeconds - (pausedAt ? now - pausedAt : 0)
  // so both apps compute the same value from the same three fields and a phone
  // with a wrong clock cannot drift the shared total.
  pausedAt         DateTime?      // non-null = paused right now
  pausedSeconds    Int            @default(0) // accumulated paused time
  workDoneAt       DateTime?      // pro marked work finished — starts the 3-day auto-release clock
  // Materials receipt, attached by the PRO when marking work done — they are
  // the one who bought the materials. The customer sees it before confirming
  // completion, which is the only point at which checking it can change
  // anything: materials are prepaid from the estimate given at application.
  receiptUrl       String?
  receiptUploadedAt DateTime?
  handymanPaidOut  Boolean       @default(false)
  paidOutAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer  User          @relation("CustomerBookings", fields: [customerId], references: [id])
  handyman  User          @relation("HandymanBookings", fields: [handymanId], references: [id])
  service   Service       @relation(fields: [serviceId], references: [id])
  promoCode PromoCode?    @relation(fields: [promoCodeId], references: [id])
  review    Review?
  phases    BookingPhase[]
  messages  Message[]
  tips      Tip[]
  extensions BookingExtension[]
  proxySessions ProxySession[]

  // Created by migration 007 but never declared here, so schema and database
  // have disagreed since 2026-08-26 and the deploy drift gate has been failing
  // on it. The index is wanted — completion uses it to close the originating
  // request — so the schema is corrected to match, not the database.
  @@index([jobRequestId])
  // The review queue's index is PARTIAL (WHERE "materialsVerified" = 'review')
  // and lives in migration 015, because a full index on a column that is
  // 'none' for almost every booking buys nothing and costs every write.
  // Prisma cannot express a partial index, so it is not declared here —
  // the same arrangement as the PostGIS GiST indexes. Declaring the full
  // index instead would make the drift gate ask for a second, redundant one.
  @@map("bookings")
}

model BookingExtension {
  id                String    @id @default(cuid())
  bookingId         String
  additionalMinutes Int
  extraAmount       Float     @default(0)
  reason            String?
  status            String    @default("PENDING") // PENDING, APPROVED, DECLINED
  createdAt         DateTime  @default(now())
  respondedAt       DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_extensions")
}

model Tip {
  id               String   @id @default(cuid())
  bookingId        String
  amount           Float
  stripeSessionId  String?
  createdAt        DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("tips")
}

model BookingPhase {
  id          String    @id @default(cuid())
  bookingId   String
  title       String
  startedAt   DateTime  @default(now())
  confirmedAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_phases")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  authorId   String
  receiverId String
  rating     Int      // 1-5
  comment    String?
  handymanReply    String?
  handymanRepliedAt DateTime?
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  author   User    @relation("ReviewsGiven", fields: [authorId], references: [id])
  receiver User    @relation("ReviewsReceived", fields: [receiverId], references: [id])

  @@map("reviews")
}

model JobRequest {
  id          String          @id @default(cuid())
  customerId  String
  category    ServiceCategory
  title       String
  description String
  address     String
  city        String
  // Client-supplied and UNTRUSTED. Retained for display only; never used for
  // eligibility. Geographic matching reads servicePoint, which the server derives.
  latitude    Float?
  longitude   Float?
  scheduledAt DateTime
  budgetMin   Float
  budgetMax   Float
  // Tarea AI's estimate of billable time for this job (migration 012). Every
  // applicant is quoted on the SAME minutes at their OWN rate, so the customer
  // compares like with like.
  estimatedBillableMinutes Int?
  materialsCost Float         @default(0) // furniture/materials the customer buys; INCLUDED in the CSLB $1,000 cap (AB 2622)
  urgency     String          @default("STANDARD") // STANDARD, SOON, URGENT
  // DRAFT = geocoding failed or was low confidence; not published, not matchable.
  // Every read path either filters status="OPEN" or rejects non-OPEN, so a DRAFT
  // job is inert: invisible to pros and unappliable.
  status      String          @default("OPEN") // DRAFT, OPEN, ASSIGNED, CLOSED

  // Server-derived location. Written only from a server-side geocode of `address`
  // — never from client input. Unsupported() because Prisma has no geography
  // type: queried via $queryRaw so ST_DWithin can use the GiST index.
  servicePoint      Unsupported("geography(Point, 4326)")? @map("service_point")
  geocodeConfidence Float?    @map("geocode_confidence")
  geocodeSource     String?   @map("geocode_source")
  geocodeError      String?   @map("geocode_error")
  geocodedAt        DateTime? @map("geocoded_at")
  imageUrls   String[]        @default([])
  // The CUSTOMER's own requirement, distinct from the law's. Roofing and HVAC
  // are licence-only whatever this says (see licenseAlwaysRequired); this lets a
  // customer impose the same restriction on a trade where it is optional. It
  // only ever narrows who may apply — it cannot admit an unlicensed pro to a
  // trade that requires one. Migration 014.
  requiresLicensed Boolean     @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  customer     User             @relation("CustomerJobRequests", fields: [customerId], references: [id])
  applications JobApplication[]

  // Partial index (WHERE "requiresLicensed" = true) in migration 014, for the
  // same reason as bookings.materialsVerified above: restricted jobs are the
  // minority and the only rows the eligibility gate reasons about separately.
  @@map("job_requests")
}

model JobApplication {
  id            String   @id @default(cuid())
  jobRequestId  String
  handymanId    String
  userId        String
  message           String?
  proposedPrice     Float?
  materialsEstimate Float?
  status            String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime @default(now())

  jobRequest JobRequest      @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  handyman   HandymanProfile @relation(fields: [handymanId], references: [id])
  user       User            @relation("HandymanApplications", fields: [userId], references: [id])

  @@unique([jobRequestId, handymanId])
  @@map("job_applications")
}

model PortfolioPhoto {
  id        String   @id @default(cuid())
  profileId String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  profile HandymanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("portfolio_photos")
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  handymanId String
  createdAt  DateTime @default(now())

  customer User            @relation("CustomerFavorites", fields: [customerId], references: [id], onDelete: Cascade)
  handyman HandymanProfile @relation(fields: [handymanId], references: [id], onDelete: Cascade)

  @@unique([customerId, handymanId])
  @@map("favorites")
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessagesSent", fields: [senderId], references: [id])

  @@map("messages")
}

model PromoCode {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   // "PERCENT" | "FLAT"
  discountValue Float
  maxUses       Int?
  usesCount     Int      @default(0)
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  firstOrderOnly Boolean @default(false) // redeemable only on the customer's first paid booking
  ownerId       String?  // if set, only this user may redeem the code (null = public/global)
  createdAt     DateTime @default(now())

  bookings Booking[]

  @@index([ownerId])
  @@map("promo_codes")
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  type      String   // booking_request, booking_accepted, job_completed, review
  refId     String?  // bookingId or reviewId
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model StripeWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  status    String   @default("processed")
  payload   Json
  createdAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

model ActiveState {
  state       String    @id  // e.g. "FL", "CA"
  isActive    Boolean   @default(false)
  activatedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("active_states")
}

// Anonymous calling: both parties dial a shared Telnyx `proxyNumber` and are
// bridged to each other, so neither sees the other's real phone number. One
// ACTIVE session per booking holds a proxy number from the pool until it
// expires (or is released), then the number returns to the pool for reuse.
model ProxySession {
  id            String    @id @default(cuid())
  bookingId     String
  proxyNumber   String    // E.164 Telnyx number both parties dial
  customerPhone String    // E.164, never exposed to the handyman
  handymanPhone String    // E.164, never exposed to the customer
  status        String    @default("ACTIVE") // ACTIVE | RELEASED
  expiresAt     DateTime
  lastCallSid   String?
  createdAt     DateTime  @default(now())
  releasedAt    DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([proxyNumber, status])
  @@index([bookingId])
  @@map("proxy_sessions")
}
