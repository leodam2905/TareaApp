// Tarea - Handyman App Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  HANDYMAN
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ServiceCategory {
  PLUMBING
  ELECTRICAL
  CARPENTRY
  PAINTING
  CLEANING
  HVAC
  ROOFING
  LANDSCAPING
  MOVING
  APPLIANCE_REPAIR
  GENERAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone           String?
  expoPushToken   String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  avatarUrl    String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  latitude     Float?
  longitude    Float?
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  stripeAccountId     String?
  stripeAccountStatus String?
  notifBookingUpdates Boolean @default(true)
  notifReminders      Boolean @default(true)
  notifMessages       Boolean @default(true)
  notifSms            Boolean @default(false)
  referralCode        String? @unique
  referredBy          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  handymanProfile    HandymanProfile?
  bookingsAsCustomer Booking[]        @relation("CustomerBookings")
  bookingsAsHandyman Booking[]        @relation("HandymanBookings")
  reviewsGiven       Review[]         @relation("ReviewsGiven")
  reviewsReceived    Review[]         @relation("ReviewsReceived")
  notifications      Notification[]
  jobRequests        JobRequest[]     @relation("CustomerJobRequests")
  jobApplications    JobApplication[] @relation("HandymanApplications")
  messagesSent       Message[]        @relation("MessagesSent")
  otpCodes           OtpCode[]
  favorites          Favorite[]       @relation("CustomerFavorites")

  @@map("users")
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

model HandymanProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  yearsExperience Int      @default(0)
  hourlyRate      Float
  isAvailable     Boolean  @default(true)
  rating          Float    @default(0)
  totalJobs       Int      @default(0)
  totalEarnings   Float    @default(0)
  responseTime    Int      @default(60)
  serviceRadius   Int      @default(50)
  isPremium             Boolean  @default(false)
  stripeSubId           String?
  stripeSubStatus       String?
  verificationDocUrl    String?
  verificationStatus    String   @default("none") // none | pending | approved | rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     Service[]
  availability    HandymanAvailability[]
  jobApplications JobApplication[]
  portfolioPhotos PortfolioPhoto[]
  favorites Favorite[]

  @@map("handyman_profiles")
}

model HandymanAvailability {
  id        String @id @default(cuid())
  profileId String
  dayOfWeek Int    // 0=Sun … 6=Sat
  startHour Int    // 0-23
  endHour   Int    // 0-23

  profile HandymanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dayOfWeek])
  @@map("handyman_availability")
}

model Service {
  id          String          @id @default(cuid())
  handymanId  String?
  title       String
  description String
  category    ServiceCategory
  minPrice    Float
  maxPrice    Float
  duration    Int             // in minutes
  imageUrl    String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  handyman HandymanProfile? @relation(fields: [handymanId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("services")
}

model Booking {
  id           String        @id @default(cuid())
  customerId   String
  handymanId   String
  serviceId    String
  promoCodeId  String?
  status       BookingStatus @default(PENDING)
  scheduledAt  DateTime
  address      String
  city         String
  notes        String?
  totalPrice   Float
  isPaid                Boolean       @default(false)
  stripeSessionId       String?
  stripePaymentIntentId String?
  completedAt      DateTime?
  cancelReason     String?
  responseDeadline DateTime?
  isOnMyWay        Boolean       @default(false)
  handymanLat      Float?
  handymanLng      Float?
  disputeReason    String?
  disputedBy       String?
  disputedAt       DateTime?
  resolutionNote   String?
  resolvedAt       DateTime?
  handymanPaidOut  Boolean       @default(false)
  paidOutAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer  User          @relation("CustomerBookings", fields: [customerId], references: [id])
  handyman  User          @relation("HandymanBookings", fields: [handymanId], references: [id])
  service   Service       @relation(fields: [serviceId], references: [id])
  promoCode PromoCode?    @relation(fields: [promoCodeId], references: [id])
  review    Review?
  phases    BookingPhase[]
  messages  Message[]

  @@map("bookings")
}

model BookingPhase {
  id          String    @id @default(cuid())
  bookingId   String
  title       String
  startedAt   DateTime  @default(now())
  confirmedAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_phases")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  authorId   String
  receiverId String
  rating     Int      // 1-5
  comment    String?
  handymanReply    String?
  handymanRepliedAt DateTime?
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  author   User    @relation("ReviewsGiven", fields: [authorId], references: [id])
  receiver User    @relation("ReviewsReceived", fields: [receiverId], references: [id])

  @@map("reviews")
}

model JobRequest {
  id          String          @id @default(cuid())
  customerId  String
  category    ServiceCategory
  title       String
  description String
  address     String
  city        String
  latitude    Float?
  longitude   Float?
  scheduledAt DateTime
  budgetMin   Float
  budgetMax   Float
  status      String          @default("OPEN") // OPEN, ASSIGNED, CLOSED
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  customer     User             @relation("CustomerJobRequests", fields: [customerId], references: [id])
  applications JobApplication[]

  @@map("job_requests")
}

model JobApplication {
  id            String   @id @default(cuid())
  jobRequestId  String
  handymanId    String
  userId        String
  message       String?
  proposedPrice Float?
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime @default(now())

  jobRequest JobRequest      @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  handyman   HandymanProfile @relation(fields: [handymanId], references: [id])
  user       User            @relation("HandymanApplications", fields: [userId], references: [id])

  @@unique([jobRequestId, handymanId])
  @@map("job_applications")
}

model PortfolioPhoto {
  id        String   @id @default(cuid())
  profileId String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  profile HandymanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("portfolio_photos")
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  handymanId String
  createdAt  DateTime @default(now())

  customer User            @relation("CustomerFavorites", fields: [customerId], references: [id], onDelete: Cascade)
  handyman HandymanProfile @relation(fields: [handymanId], references: [id], onDelete: Cascade)

  @@unique([customerId, handymanId])
  @@map("favorites")
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessagesSent", fields: [senderId], references: [id])

  @@map("messages")
}

model PromoCode {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   // "PERCENT" | "FLAT"
  discountValue Float
  maxUses       Int?
  usesCount     Int      @default(0)
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  bookings Booking[]

  @@map("promo_codes")
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  type      String   // booking_request, booking_accepted, job_completed, review
  refId     String?  // bookingId or reviewId
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model StripeWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  status    String   @default("processed")
  payload   Json
  createdAt DateTime @default(now())

  @@map("stripe_webhook_events")
}
