# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/tarea_db"

# JWT secret (change this to a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"

# Optional: App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — payments (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Certn — background checks (https://app.certn.co/settings/api)
CERTN_API_KEY=""
CERTN_WEBHOOK_SECRET=""

# Resend — transactional email (https://resend.com/api-keys)
RESEND_API_KEY=""

# Telnyx — SMS (https://portal.telnyx.com → API Keys + Numbers)
# Leave TELNYX_API_KEY blank to print the OTP to the server console in dev.
TELNYX_API_KEY=""
TELNYX_PHONE_NUMBER=""
TELNYX_MESSAGING_PROFILE_ID=""

# Cloudflare R2 — image/file storage, S3-compatible (dash.cloudflare.com → R2)
# Endpoint is derived from R2_ACCOUNT_ID; R2_PUBLIC_URL is the bucket's public
# delivery URL (r2.dev subdomain or custom domain). All four (+bucket) required
# for r2Configured() to return true.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="tarea-media"
R2_PUBLIC_URL=""

# Cloudinary — legacy image storage, used only when R2 is not configured
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
