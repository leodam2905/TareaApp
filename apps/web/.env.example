# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/tarea_db"

# JWT secret (change this to a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"

# Optional: App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — payments (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Certn — background checks (https://app.certn.co/settings/api)
CERTN_API_KEY=""
CERTN_WEBHOOK_SECRET=""

# Resend — transactional email (https://resend.com/api-keys)
RESEND_API_KEY=""

# Telnyx — SMS (https://portal.telnyx.com → API Keys + Numbers)
TELNYX_API_KEY=""
TELNYX_PHONE_NUMBER=""

# Cloudinary — image storage (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
