# Keep the Cloud Build upload lean and deterministic. node_modules is rebuilt
# in the Dockerfile's deps stage, and .next is volatile build cache (a file
# vanishing mid-archive previously crashed the upload). Mirrors .dockerignore.
.next/
node_modules/
.git/
.env
.env.local
.env*.local
README.md

# Credentials. NOT covered by .gitignore: once this file exists, gcloud stops
# consulting .gitignore entirely, so a gitignored secret is still uploaded.
# deploy-sa-key.json is a never-expiring key holding secretmanager.admin, and it
# was going into every Cloud Build source archive.
deploy-sa-key.json
*-sa-key.json
*-key.json
*.pem
*.p8
